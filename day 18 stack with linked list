class Main {

    // Node class
    class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    Node top = null;

    // Push operation
    void push(int data) {
        Node newNode = new Node(data);

        newNode.next = top;
        top = newNode;

        System.out.println(data + " pushed");
    }

    // Pop operation
    void pop() {
        if (top == null) {
            System.out.println("Stack is empty");
            return;
        }

        System.out.println(top.data + " popped");
        top = top.next;
    }

    // Display operation
    void display() {
        if (top == null) {
            System.out.println("Stack is empty");
            return;
        }

        Node temp = top;

        System.out.print("Stack: ");

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }

        System.out.println();
    }

    public static void main(String[] args) {
        Main s = new Main();

        s.push(10);
        s.push(20);
        s.push(30);

        s.display();

        s.pop();

        s.display();

        s.pop();

        s.display();
    }
}
output
  10 pushed
20 pushed
30 pushed
Stack: 30 20 10
30 popped
Stack: 20 10
20 popped
Stack: 10
