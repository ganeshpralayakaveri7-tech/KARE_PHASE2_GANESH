// Node class for circular doubly linked list
class Node {
    int data;
    Node prev;
    Node next;

    Node(int data) {
        this.data = data;
        this.prev = null;
        this.next = null;
    }
}

// Circular Doubly Linked List class
public class CircularDoublyLinkedList {
    private Node head; // points to the first node; list is circular

    public CircularDoublyLinkedList() {
        head = null;
    }

    // Insert at the end of the list
    public void insert(int value) {
        Node newNode = new Node(value);

        if (head == null) {
            // First node: point to itself in both directions
            head = newNode;
            head.next = head;
            head.prev = head;
            return;
        }

        Node last = head.prev; // because list is circular, last = head.prev

        // Link new node with last and head
        last.next = newNode;
        newNode.prev = last;

        newNode.next = head;
        head.prev = newNode;
    }

    // Display the list (forward direction)
    public void display() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        Node current = head;
        do {
            System.out.print(current.data + " ");
            current = current.next;
        } while (current != head);
        System.out.println();
    }

    // Compute sum of all elements
    public int sum() {
        if (head == null) {
            return 0;
        }

        int total = 0;
        Node current = head;

        do {
            total += current.data;
            current = current.next;
        } while (current != head);

        return total;
    }

    // Find maximum element
    public int max() {
        if (head == null) {
            throw new IllegalStateException("List is empty");
        }

        int maximum = head.data;
        Node current = head.next;

        while (current != head) {
            if (current.data > maximum) {
                maximum = current.data;
            }
            current = current.next;
        }

        return maximum;
    }

    // Sort the list in ascending order (bubble-sort style on data)
    public void sort() {
        if (head == null || head.next == head) {
            return; // 0 or 1 element
        }

        boolean swapped;
        do {
            swapped = false;
            Node current = head;

            while (current.next != head) {
                if (current.data > current.next.data) {
                    int temp = current.data;
                    current.data = current.next.data;
                    current.next.data = temp;
                    swapped = true;
                }
                current = current.next;
            }

            // Compare last node with head (circular)
            if (current.data > head.data) {
                int temp = current.data;
                current.data = head.data;
                head.data = temp;
                swapped = true;
            }

        } while (swapped);
    }

    // Reverse the circular doubly linked list
    public void reverse() {
        if (head == null || head.next == head) {
            return; // 0 or 1 element
        }

        Node current = head;
        Node temp = null;

        // Swap prev and next for every node
        do {
            temp = current.prev;
            current.prev = current.next;
            current.next = temp;

            current = current.prev; // move to next node (which is now in prev)
        } while (current != head);

        // After swapping links, move head to previous node
        temp = head;
        head = head.prev;
    }

    // Main method: insert, sort, reverse, and test
    public static void main(String[] args) {
        CircularDoublyLinkedList list = new CircularDoublyLinkedList();

        // Insert elements
        list.insert(30);
        list.insert(10);
        list.insert(50);
        list.insert(20);
        list.insert(5);

        System.out.print("Original list:     ");
        list.display();

        System.out.println("Sum: " + list.sum());
        System.out.println("Max: " + list.max());

        list.sort();
        System.out.print("Sorted list:       ");
        list.display();

        list.reverse();
        System.out.print("Reversed list:     ");
        list.display();

        System.out.println("Sum after reverse: " + list.sum());
        System.out.println("Max after reverse: " + list.max());
    }
}
