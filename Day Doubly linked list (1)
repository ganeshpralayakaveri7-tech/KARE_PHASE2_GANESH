// Node class for circular doubly linked list
class Node {
    int data;
    Node prev;
    Node next;

    Node(int data) {
        this.data = data;
        this.prev = null;
        this.next = null;
    }
}

// Circular Doubly Linked List class
public class CircularDoublyLinkedList {
    private Node head; // points to the first node; list is circular

    public CircularDoublyLinkedList() {
        head = null;
    }

    // Insert at the end of the list
    public void insert(int value) {
        Node newNode = new Node(value);

        if (head == null) {
            // First node: point to itself in both directions
            head = newNode;
            head.next = head;
            head.prev = head;
            return;
        }

        Node last = head.prev; // because list is circular, last = head.prev

        // Link new node with last and head
        last.next = newNode;
        newNode.prev = last;

        newNode.next = head;
        head.prev = newNode;
    }

    // Compute sum of all elements in the circular doubly linked list
    public int sum() {
        if (head == null) {
            return 0;
        }

        int total = 0;
        Node current = head;

        do {
            total += current.data;
            current = current.next;
        } while (current != head);

        return total;
    }

    // Display the list (forward direction)
    public void display() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        Node current = head;
        do {
            System.out.print(current.data + " ");
            current = current.next;
        } while (current != head);
        System.out.println();
    }

    // Main method: insert elements and test sum
    public static void main(String[] args) {
        CircularDoublyLinkedList list = new CircularDoublyLinkedList();

        // Insert elements
        list.insert(30);
        list.insert(10);
        list.insert(50);
        list.insert(20);
        list.insert(5);

        System.out.print("List elements: ");
        list.display();

        int sum = list.sum();
        System.out.println("Sum of elements: " + sum);
    }
}
