class Main {
    int[] stack;
    int top;
    int size;

    // Constructor
    Main(int size) {
        this.size = size;
        stack = new int[size];
        top = -1;
    }

    // Push operation
    void push(int data) {
        if (top == size - 1) {
            System.out.println("Stack is full");
            return;
        }

        top++;
        stack[top] = data;
        System.out.println(data + " pushed");
    }

    // Pop operation
    void pop() {
        if (top == -1) {
            System.out.println("Stack is empty");
            return;
        }

        System.out.println(stack[top] + " popped");
        top--;
    }

    // Display operation
    void display() {
        if (top == -1) {
            System.out.println("Stack is empty");
            return;
        }

        System.out.print("Stack: ");

        for (int i = top; i >= 0; i--) {
            System.out.print(stack[i] + " ");
        }

        System.out.println();
    }

    public static void main(String[] args) {
        Main s = new Main(5);

        s.push(10);
        s.push(20);
        s.push(30);

        s.display();

        s.pop();

        s.display();
    }
}

output
10 pushed
20 pushed
30 pushed
Stack: 30 20 10
30 popped
Stack: 20 10
  
